{
  "name": "tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Task tracker monorepo (Express + Prisma + React).",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run db:deploy && concurrently -n server,web -c blue,magenta \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "db:generate": "npm run db:generate -w apps/server",
    "db:migrate": "npm run db:migrate:dev -w apps/server",
    "db:deploy": "npm run db:migrate:deploy -w apps/server",
    "db:studio": "npm run db:studio -w apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
