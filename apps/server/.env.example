# SQLite connection string used by Prisma and the Express server.
# Format: file:<relative-or-absolute-path>
# - For local dev (no compose), a relative path is fine; Prisma resolves it
#   against apps/server (where prisma generate is run).
# - For tests, CI uses file:./test.db.
DATABASE_URL="file:./dev.db"

# Server
PORT=3000
NODE_ENV=development

# CORS: comma-separated list of allowed origins for the API.
# - "http://localhost:5173" — Vite dev server (default)
# - "http://localhost:3000" — direct API access (Postman, curl, etc.)
# - Use "*" to allow any origin (disables credentialed requests).
# - In production, set to your deployed web origin, e.g. "https://tracker.example.com".
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
